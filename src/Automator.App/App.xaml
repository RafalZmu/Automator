<Application
    x:Class="Automator.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PanelTintBrush" Color="#0CFFFFFF" />
                    <SolidColorBrush x:Key="PanelBorderBrush" Color="#80FFFFFF" />
                    <SolidColorBrush x:Key="SearchSurfaceBrush" Color="#4AFFFFFF" />
                    <SolidColorBrush x:Key="TileSurfaceBrush" Color="#45FFFFFF" />
                    <SolidColorBrush x:Key="TileHoverBrush" Color="#A6FFFFFF" />
                    <SolidColorBrush x:Key="IconSurfaceBrush" Color="#48FFFFFF" />
                    <SolidColorBrush x:Key="AliasChipBrush" Color="#30369BA5" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#B9000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PanelTintBrush" Color="#18364850" />
                    <SolidColorBrush x:Key="PanelBorderBrush" Color="#52FFFFFF" />
                    <SolidColorBrush x:Key="SearchSurfaceBrush" Color="#38404D58" />
                    <SolidColorBrush x:Key="TileSurfaceBrush" Color="#48404D58" />
                    <SolidColorBrush x:Key="TileHoverBrush" Color="#99516270" />
                    <SolidColorBrush x:Key="IconSurfaceBrush" Color="#5062717D" />
                    <SolidColorBrush x:Key="AliasChipBrush" Color="#555C8D96" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#BFFFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
