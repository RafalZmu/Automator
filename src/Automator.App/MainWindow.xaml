<Window
    x:Class="Automator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:launcher="using:Automator.Core.Launcher"
    Title="Automator">
    <Border x:Name="PanelSurface"
            Background="Transparent"
            BorderBrush="{ThemeResource PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="0">
        <Grid Background="Transparent">
            <!-- Keep the desktop Acrylic inside the rounded card, not across the rectangular HWND. -->
            <controls:SystemBackdropElement x:Name="BackdropElement"
                                            CornerRadius="16"
                                            IsHitTestVisible="False" />
            <Grid x:Name="RootGrid" Margin="18" KeyDown="OnRootKeyDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel x:Name="TabStrip"
                        Grid.Row="0"
                        Orientation="Horizontal"
                        Spacing="7"
                        Margin="0,0,0,12" />

            <Grid x:Name="LauncherTabSurface" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{ThemeResource SearchSurfaceBrush}"
                        BorderBrush="{ThemeResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Margin="0,0,0,12">
                    <TextBox x:Name="QueryBox"
                             Height="48"
                             Padding="14,0"
                             Background="Transparent"
                             BorderBrush="Transparent"
                             BorderThickness="0"
                             PlaceholderText="Type an app alias…  / to bind an app"
                             VerticalContentAlignment="Center"
                             TextChanged="OnQueryTextChanged"
                             KeyDown="OnQueryKeyDown">
                        <TextBox.Resources>
                            <!-- The stock focused state paints an opaque fill and accent underline. -->
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                        </TextBox.Resources>
                    </TextBox>
                </Border>

                <ListView x:Name="BoundAppsView"
                          Grid.Row="1"
                          IsItemClickEnabled="True"
                          ItemClick="OnBoundAppClicked"
                          SelectionMode="None"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="0"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ItemsSource="{x:Bind BoundApps, Mode=OneWay}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="launcher:AppBinding">
                            <Border MinHeight="62"
                                    Padding="12,9"
                                    CornerRadius="12"
                                    Background="{ThemeResource TileSurfaceBrush}"
                                    BorderBrush="{ThemeResource PanelBorderBrush}"
                                    BorderThickness="1">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34"
                                            Height="34"
                                            CornerRadius="10"
                                            Background="{ThemeResource IconSurfaceBrush}"
                                            VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE8A5;"
                                                  FontSize="19"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind Name}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="2"
                                            MinWidth="38"
                                            Padding="9,5"
                                            CornerRadius="8"
                                            Background="{ThemeResource AliasChipBrush}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Alias}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource MutedTextBrush}"
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <ListView x:Name="CatalogView"
                          Grid.Row="1"
                          Visibility="Collapsed"
                          IsItemClickEnabled="True"
                          ItemClick="OnCatalogItemClicked"
                          SelectionMode="None"
                          Background="Transparent"
                          BorderThickness="0"
                          Margin="0,44,0,0"
                          ItemsSource="{x:Bind CatalogApps, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="launcher:AppBinding">
                            <Grid Padding="8,6" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8A5;" FontSize="20" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind TargetPath}"
                                               FontSize="11"
                                               Foreground="{ThemeResource MutedTextBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel x:Name="AliasEntryPanel"
                            Grid.Row="1"
                            Visibility="Collapsed"
                            Spacing="10"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <TextBlock x:Name="AliasPrompt"
                               FontSize="18"
                               FontWeight="SemiBold"
                               TextAlignment="Center" />
                    <TextBlock Text="Choose a unique alias using letters, then press Enter."
                               Foreground="{ThemeResource MutedTextBrush}"
                               TextAlignment="Center" />
                    <TextBox x:Name="AliasBox"
                             Width="190"
                             MaxLength="12"
                             PlaceholderText="e.g. cx"
                             HorizontalAlignment="Center"
                             TextChanged="OnAliasTextChanged"
                             KeyDown="OnAliasKeyDown" />
                    <Button Content="Save binding"
                            HorizontalAlignment="Center"
                            Click="OnSaveAliasClicked" />
                </StackPanel>

                <Button x:Name="AddCustomAppButton"
                        Grid.Row="1"
                        Content="Add an app…"
                        Visibility="Collapsed"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,0,6,0"
                        Click="OnAddCustomAppClicked" />
            </Grid>

            <Grid x:Name="ReservedTabPanel"
                  Grid.Row="1"
                  Visibility="Collapsed"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center">
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <TextBlock x:Name="ReservedTabTitle"
                               FontSize="20"
                               FontWeight="SemiBold"
                               TextAlignment="Center" />
                    <TextBlock Text="This slot is ready for a future automation module."
                               Foreground="{ThemeResource MutedTextBrush}"
                               TextAlignment="Center" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource MutedTextBrush}" />
                <Button x:Name="ExitButton"
                        Content="Exit"
                        Visibility="Collapsed"
                        HorizontalAlignment="Right"
                        Margin="0,0,90,0"
                        Click="OnExitClicked" />
                <Button Content="Settings"
                        HorizontalAlignment="Right"
                        Click="OnSettingsClicked" />
            </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
